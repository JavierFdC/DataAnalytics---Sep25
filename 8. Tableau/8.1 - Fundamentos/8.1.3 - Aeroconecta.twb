      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0mp6dll1tu83pl1d7t05x11roeyr].[ctd:flight_id:qk]&quot;' value='Vuelos' />
        </aliases>
      </column>
      <column caption='Ocupación %' datatype='real' name='[Calculation_1779603313352704]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([seats_sold])/SUM([seats_total])' />
      </column>
      <column caption='Yield Medio' datatype='real' name='[Calculation_1779603316514817]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1779603319099397])/SUM([seats_sold])' />
      </column>
      <column caption='Ingresos' datatype='real' name='[Calculation_1779603319099397]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT([ingreso_vuelo])' />
      </column>
      <column aggregation='Avg' caption='Latitud Destino' datatype='real' name='[Calculation_1779603319660550]' role='measure' semantic-role='[Geographical].[Latitude]' type='quantitative'>
        <calculation class='tableau' formula='FLOAT([destination_lat])' />
      </column>
      <column aggregation='Avg' caption='Longitud Destino' datatype='real' name='[Calculation_1779603319848967]' role='measure' semantic-role='[Geographical].[Longitude]' type='quantitative'>
        <calculation class='tableau' formula='FLOAT([destination_lon])' />
      </column>
      <column aggregation='Avg' caption='Latitud Origen' datatype='real' name='[Calculation_1779603319967752]' role='measure' semantic-role='[Geographical].[Latitude]' type='quantitative'>
        <calculation class='tableau' formula='FLOAT([origin_lat])' />
      </column>
      <column aggregation='Avg' caption='Longitud Origen' datatype='real' name='[Calculation_1779603320033289]' role='measure' semantic-role='[Geographical].[Longitude]' type='quantitative'>
        <calculation class='tableau' formula='FLOAT([origin_lon])' />
      </column>
      <column caption='Fecha Vuelo' datatype='datetime' name='[Calculation_2204014094516224]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF CONTAINS([flight_date], &quot;-&quot;) AND LEN([flight_date])=10 THEN&#13;&#10;    DATEPARSE(&quot;yyyy-mm-dd&quot;, [flight_date])&#13;&#10;ELSEIF CONTAINS([flight_date], &quot;/&quot;) THEN&#13;&#10;    DATEPARSE(&quot;dd/mm/yyyy&quot;, [flight_date])&#13;&#10;ELSE&#13;&#10;    DATEPARSE(&quot;m-d-yy&quot;, [flight_date])&#13;&#10;END' />
      </column>
      <column caption='Tipo Aeronave' datatype='string' name='[Calculation_2204014097059841]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NOT ISNULL([aircraft_type]) THEN [aircraft_type]&#13;&#10;ELSEIF [seats_total]= 180 THEN &quot;Airbus A320&quot;&#13;&#10;ELSEIF [seats_total]= 220 THEN &quot;Airbus A321&quot;&#13;&#10;ELSE &quot;Desconocido&quot;&#13;&#10;END' />
      </column>
      <column datatype='string' name='[Causa Retraso]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[delay_cause]' new-bin='true'>
          <bin default-name='true' value='&quot;ATC&quot;'>
            <value>&quot;ATC&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Meteorología&quot;'>
            <value>&quot;meteorologia&quot;</value>
            <value>&quot;Meteorologia&quot;</value>
            <value>&quot;METEOROLOGIA&quot;</value>
            <value>&quot;Weather&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Operativa&quot;'>
            <value>&quot;operativa&quot;</value>
            <value>&quot;Operativa&quot;</value>
            <value>&quot;OPERATIVA&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Sin Retraso&quot;'>
            <value>&quot;Sin retraso&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Técnico&quot;'>
            <value>&quot;Technical&quot;</value>
            <value>&quot;tecnica&quot;</value>
            <value>&quot;Tecnica&quot;</value>
            <value>&quot;TECNICA&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Tráfico Aereo&quot;'>
            <value>&quot;trafico aereo&quot;</value>
            <value>&quot;Trafico Aereo&quot;</value>
            <value>&quot;TRAFICO AEREO&quot;</value>
          </bin>
        </calculation>
      </column>
      <column datatype='string' name='[Ciudad Destino]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
        <calculation class='categorical-bin' column='[destination_city]' new-bin='true'>
          <bin default-name='false' value='&quot;Barcelona&quot;'>
            <value>&quot;barcelona&quot;</value>
            <value>&quot;Barcelona&quot;</value>
            <value>&quot;BARCELONA&quot;</value>
          </bin>
