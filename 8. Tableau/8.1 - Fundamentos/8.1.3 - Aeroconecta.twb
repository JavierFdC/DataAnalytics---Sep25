            <column caption='Fecha Vuelo' datatype='datetime' name='[Calculation_2204014094516224]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF CONTAINS([flight_date], &quot;-&quot;) AND LEN([flight_date])=10 THEN&#13;&#10;    DATEPARSE(&quot;yyyy-mm-dd&quot;, [flight_date])&#13;&#10;ELSEIF CONTAINS([flight_date], &quot;/&quot;) THEN&#13;&#10;    DATEPARSE(&quot;dd/mm/yyyy&quot;, [flight_date])&#13;&#10;ELSE&#13;&#10;    DATEPARSE(&quot;m-d-yy&quot;, [flight_date])&#13;&#10;END' />
            </column>
            <column caption='Tipo Aeronave' datatype='string' name='[Calculation_2204014097059841]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF NOT ISNULL([aircraft_type]) THEN [aircraft_type]&#13;&#10;ELSEIF [seats_total]= 180 THEN &quot;Airbus A320&quot;&#13;&#10;ELSEIF [seats_total]= 220 THEN &quot;Airbus A321&quot;&#13;&#10;ELSE &quot;Desconocido&quot;&#13;&#10;END' />
