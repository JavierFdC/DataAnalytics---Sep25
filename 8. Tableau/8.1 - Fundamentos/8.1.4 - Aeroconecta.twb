              <calculation class='tableau' formula='IF NOT ISNULL([aircraft_type]) THEN [aircraft_type]&#13;&#10;ELSEIF [seats_total]= 180 THEN &quot;Airbus A320&quot;&#13;&#10;ELSEIF [seats_total]= 220 THEN &quot;Airbus A321&quot;&#13;&#10;ELSE &quot;Desconocido&quot;&#13;&#10;END' />
